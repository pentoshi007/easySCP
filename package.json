{
  "name": "@pentoshi/easyscp",
  "version": "0.1.0",
  "description": "Friendly, fast file transfers over SSH — right from your terminal",
  "keywords": [
    "scp",
    "sftp",
    "ssh",
    "file-transfer",
    "cli",
    "tui"
  ],
  "license": "MIT",
  "author": "Aniket Pandey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pentoshi007/easySCP.git"
  },
  "homepage": "https://github.com/pentoshi007/easySCP#readme",
  "bugs": "https://github.com/pentoshi007/easySCP/issues",
  "type": "module",
  "bin": {
    "easyscp": "dist/cli.js",
    "escp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:binary": "node scripts/sea.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.0",
    "ssh2": "1.17.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/ssh2": "1.15.6",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
